expression fxRenameCols =
		// fxRenameCols
		let
		    Fonte = (tabela as table, dic as table) as table =>
		let
		    lk = Record.FromList(dic[Rename], List.Transform(dic[Chave], Text.From)),
		    ren = List.RemoveNulls(List.Transform(
		        Table.ColumnNames(tabela),
		        (c) => let n = fxPrefixoNum(c),
		                   novo = if n = null then null else Record.FieldOrDefault(lk, Text.From(n), null)
		               in if novo = null then null else {c, novo}))
		in
		    Table.RenameColumns(tabela, ren, MissingField.Ignore)
		in
		    Fonte
	lineageTag: 4c505d3a-c1a8-471f-8778-93ee8960c4f1
