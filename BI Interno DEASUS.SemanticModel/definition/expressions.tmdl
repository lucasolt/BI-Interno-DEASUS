expression fxTyparCols =
		// fxTyparCols — casa por nome (rodar DEPOIS do rename)
		let
		    Fonte = (tabela as table, dic as table) as table =>
		let
		    existentes = Table.ColumnNames(tabela),
		
		    Mapa = (t as text) =>
		        Table.SelectRows(dic, each [Incluir] = 1 and [Type] = t
		                                  and List.Contains(existentes, [Rename]))[Rename],
		
		    par = (nomes as list, tipo as type) =>
		        List.Transform(nomes, (n) => {n, tipo}),
		
		    trans =
		        par(Mapa("data"),    type date)
		      & par(Mapa("decimal"), type number)
		      & par(Mapa("inteiro"), Int64.Type)
		      & par(Mapa("logico"),  type logical)
		      & par(Mapa("texto"),   type text)
		in
		    Table.TransformColumnTypes(tabela, trans, "pt-BR")
		in
		    Fonte
	lineageTag: 8fcb04c5-0250-40f7-8198-0f347afe0df3
	queryGroup: fx

