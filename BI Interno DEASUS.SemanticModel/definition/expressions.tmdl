/// Caminho completo da planilha fonte (ESTUDO DOS PROCESSOS PARA ANÁLISE DO RDQA).
expression CaminhoPlanilha = "C:\Users\Lucas\OneDrive\BIs\BI-DEASUS\ESTUDO DOS PROCESSOS PARA ANÁLISE DO RDQA - Copiar.xlsx" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
