/// Status do processo (campo 42) -> fase (texto do status bruto), com quem está a próxima ação e etapa.
/// Etapa: Pré-designação e Em auditoria entram na carteira; Após a auditoria vira só contador; Arquivado fica fora.
/// Chave normalizada (fxNormalizaNome); variantes de escrita do mesmo status repetem a linha.
expression MapaFases =
		let
		    Fonte = #table(
		        type table [StatusChave = text, Fase = text, #"Fase Ordem" = Int64.Type, #"Com Quem" = text, Etapa = text],
		        {
		            {"nao distribuido",                     "Não distribuído",                      1, "Aguardando designação", "Pré-designação"},
		            {"aguarda criacao de rai",              "Aguarda criação de RAI",               2, "Com a equipe",        "Em auditoria"},
		            {"aguarda acolhimento rai",             "Aguarda acolhimento RAI",              3, "Com a chefia",        "Em auditoria"},
		            {"aguarda acolhimento do rai",          "Aguarda acolhimento RAI",              3, "Com a chefia",        "Em auditoria"},
		            {"aguarda envio do rai ao auditado",    "Aguarda envio do RAI ao auditado",     4, "Com a equipe",        "Em auditoria"},
		            {"aguarda apresentacao de defesa",      "Aguarda apresentação de defesa",       5, "Aguardando auditado", "Em auditoria"},
		            {"aguarda analise de defesa",           "Aguarda análise de defesa",            6, "Com a equipe",        "Em auditoria"},
		            {"aguarda emissao raf",                 "Aguarda emissão do RAF",               7, "Com a equipe",        "Em auditoria"},
		            {"aguarda emissao do raf",              "Aguarda emissão do RAF",               7, "Com a equipe",        "Em auditoria"},
		            {"aguarda acolhimento raf",             "Aguarda acolhimento do RAF",           8, "Com a chefia",        "Em auditoria"},
		            {"aguarda acolhimento do raf",          "Aguarda acolhimento do RAF",           8, "Com a chefia",        "Em auditoria"},
		            {"aguarda envio do raf ao auditado",    "Aguarda envio do RAF ao auditado",     9, "Com a equipe",        "Em auditoria"},
		            {"fase de auditoria finalizada",        "Fase de auditoria finalizada",        10, "Fora da carteira",    "Após a auditoria"},
		            {"aguarda interposicao de recurso",     "Aguarda interposição de recurso",     11, "Fora da carteira",    "Após a auditoria"},
		            {"aguarda analise de recurso",          "Aguarda análise de recurso",          12, "Fora da carteira",    "Após a auditoria"},
		            {"aguarda decisao",                     "Aguarda decisão",                     13, "Fora da carteira",    "Após a auditoria"},
		            {"encaminhado ao fes",                  "Encaminhado ao FES",                  14, "Fora da carteira",    "Após a auditoria"},
		            {"arquivado",                           "Arquivado",                           15, "Fora da carteira",    "Arquivado"}
		        }
		    )
		in
		    Fonte
	lineageTag: 3c9239f3-60de-4254-9e04-19bb5a72042b

	annotation PBI_ResultType = Table

