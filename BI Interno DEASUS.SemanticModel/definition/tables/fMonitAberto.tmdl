/// Monitoramentos em aberto (mesma regra do Painel de Auditorias: monitorável e Status GERAL 01 a 06) x participantes do ciclo atual.
table fMonitAberto
	lineageTag: dd6fec0d-c6e1-439c-8f15-2a01b4167fab

	column 'Nº PROA'
		dataType: string
		lineageTag: d4503af9-bc91-44e1-ac1f-8f9752f1768b
		summarizeBy: none
		sourceColumn: Nº PROA

		annotation SummarizationSetBy = Automatic

	column Ciclo
		dataType: string
		lineageTag: 8def7ece-0718-4168-bb6f-567d8466282e
		summarizeBy: none
		sourceColumn: Ciclo
		sortByColumn: 'Ciclo Nº'

		annotation SummarizationSetBy = Automatic

	column 'Ciclo Nº'
		dataType: int64
		isHidden
		lineageTag: de7e8d51-ff13-4952-94ac-4264f1b892c8
		summarizeBy: none
		sourceColumn: Ciclo Nº

