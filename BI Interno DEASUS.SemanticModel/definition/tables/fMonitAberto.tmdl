	column 'Data Inicial Designação'
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: b599ee0e-a6d5-4ef5-b1be-e97955028413
		summarizeBy: none
		sourceColumn: Data Inicial Designação

