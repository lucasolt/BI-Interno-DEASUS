/// Carteira atual da fase de Auditoria: 1 linha por processo em aberto x Função x Auditor, com fase e com quem está a próxima ação.
table fCarteira
	lineageTag: 854ffd31-f268-4151-bac9-e901f893b7f9

	column 'ID Trabalho'
		dataType: string
		lineageTag: cde529dc-9662-4514-953c-36582e8a30ee
		summarizeBy: none
		sourceColumn: ID Trabalho

		annotation SummarizationSetBy = Automatic

	column 'Nº PROA'
		dataType: string
		lineageTag: ac47f3c6-ba41-4b7c-86c4-c23b03499824
		summarizeBy: none
		sourceColumn: Nº PROA

