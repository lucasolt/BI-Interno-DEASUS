/// Carteira atual da fase de Auditoria: 1 linha por processo x Função x Auditor, do "Não distribuído" até "Aguarda envio do RAF ao auditado".
/// Etapa "Após a auditoria" (finalizada, recurso, decisão, FES) e Arquivado ficam fora (contador em fAuditoria[Etapa do Processo]).
table fCarteira
	lineageTag: 854ffd31-f268-4151-bac9-e901f893b7f9

	column 'ID Trabalho'
		dataType: string
		lineageTag: cde529dc-9662-4514-953c-36582e8a30ee
		summarizeBy: none
		sourceColumn: ID Trabalho

		annotation SummarizationSetBy = Automatic

	column 'Nº PROA'
