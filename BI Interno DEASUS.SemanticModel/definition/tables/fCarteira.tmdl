	column 'Dias desde a Última Movimentação'
		dataType: int64
		lineageTag: 465999c6-28b6-4208-955f-244cf67f7610
		summarizeBy: none
		sourceColumn: Dias desde a Última Movimentação

		annotation SummarizationSetBy = Automatic

	partition fCarteira = m
		mode: import
		source =
				let
				    Hoje = Date.From(DateTime.LocalNow()),
				    // 1 linha por Nº PROA x Função x Auditor (fAuditoria tem uma linha para RAI e outra para RAF)
				    Agrupado = Table.Group(fAuditoria, {"Nº PROA", "Função", "Auditor", "Data Designação", "Status do Processo"}, {
				        {"Data RAI", each List.Max(Table.SelectRows(_, each [Relatório] = "RAI")[Data Entrega]), type nullable date},
				        {"Data RAF", each List.Max(Table.SelectRows(_, each [Relatório] = "RAF")[Data Entrega]), type nullable date}
				    }),
				    ComChave = Table.AddColumn(Agrupado, "StatusChave", each fxNormalizaNome([Status do Processo]), type nullable text),
				    // só Pré-designação e Em auditoria (status fora do de-para também entram, como "A classificar")
				    ForaDaCarteira = List.Buffer(Table.SelectRows(MapaFases, each [Etapa] = "Após a auditoria" or [Etapa] = "Arquivado")[StatusChave]),
				    Abertos = Table.SelectRows(ComChave, each not List.Contains(ForaDaCarteira, [StatusChave])),
				    // não distribuídos: sem coordenador/designação não chegam em fAuditoria; entram aqui como "(Sem designação)" (fila da chefia)
				    Col = (codigo as text) as text =>
				        List.First(List.Select(Table.ColumnNames(stgProcessos), each Text.StartsWith(_, "(" & codigo & ")"))),
				    ProcStatus = Table.TransformColumns(
				        Table.RenameColumns(Table.SelectColumns(stgProcessos, {Col("12"), Col("42")}), {{Col("12"), "Nº PROA"}, {Col("42"), "Status do Processo"}}),
				        {{"Nº PROA", each if _ = null then null else Text.Trim(Text.From(_)), type text},
				         {"Status do Processo", each if _ = null then null else Text.Trim(Text.From(_)), type nullable text}}),
				    JaNaCarteira = List.Buffer(Abertos[Nº PROA]),
				    NaoDistribuidos = Table.Distinct(Table.SelectRows(ProcStatus, each [Nº PROA] <> null and [Nº PROA] <> ""
				        and fxNormalizaNome([Status do Processo]) = "nao distribuido" and not List.Contains(JaNaCarteira, [Nº PROA])), {"Nº PROA"}),
				    LinhasND = Table.AddColumn(Table.AddColumn(Table.AddColumn(Table.AddColumn(Table.AddColumn(Table.AddColumn(NaoDistribuidos,
				        "Função", each "Não designado", type text), "Auditor", each "(Sem designação)", type text),
				        "Data Designação", each null, type nullable date), "Data RAI", each null, type nullable date),
				        "Data RAF", each null, type nullable date), "StatusChave", each "nao distribuido", type text),
				    ComNaoDistribuidos = Table.Combine({Abertos, LinhasND}),
				    Fases = Table.Buffer(MapaFases),
				    ComFase = Table.NestedJoin(ComNaoDistribuidos, {"StatusChave"}, Fases, {"StatusChave"}, "F", JoinKind.LeftOuter),
				    Expandido = Table.ExpandTableColumn(ComFase, "F", {"Fase", "Fase Ordem", "Com Quem", "Etapa"}),
				    // status fora do de-para: mostra o próprio status e fica "A classificar" (incluir em MapaFases)
				    Renomeado = Table.RenameColumns(Expandido, {{"Fase", "FaseMapa"}, {"Fase Ordem", "OrdemMapa"}, {"Com Quem", "QuemMapa"}, {"Etapa", "EtapaMapa"}}),
				    ComFaseFinal = Table.AddColumn(Renomeado, "Fase", each
				        if [FaseMapa] <> null then [FaseMapa]
				        else if [Status do Processo] = null then "Sem status"
				        else Text.Proper([Status do Processo]), type text),
				    ComOrdemFinal = Table.AddColumn(ComFaseFinal, "Fase Ordem", each [OrdemMapa] ?? 99, Int64.Type),
				    ComQuemFinal = Table.AddColumn(ComOrdemFinal, "Com Quem", each [QuemMapa] ?? "A classificar", type text),
				    ComEtapaFinal = Table.AddColumn(ComQuemFinal, "Etapa", each [EtapaMapa] ?? "Em auditoria", type text),
				    Tabela = Table.RemoveColumns(ComEtapaFinal, {"FaseMapa", "OrdemMapa", "QuemMapa", "EtapaMapa", "StatusChave"}),
				    ComOrdemQuem = Table.AddColumn(Tabela, "Com Quem Ordem", each
				        List.PositionOf({"Com a equipe", "Com a chefia", "Aguardando auditado", "A classificar"}, [Com Quem]) + 1,
				        Int64.Type),
				    ComDias = Table.AddColumn(ComOrdemQuem, "Dias desde a Designação", each
				        if [Data Designação] = null then null else Duration.Days(Hoje - [Data Designação]), Int64.Type),
				    // aproximação de "tempo na fase": última data registrada entre designação, RAI e RAF
				    ComUltima = Table.AddColumn(ComDias, "Última Movimentação", each
				        List.Max(List.RemoveNulls({[Data Designação], [Data RAI], [Data RAF]})), type nullable date),
				    ComDiasUltima = Table.AddColumn(ComUltima, "Dias desde a Última Movimentação", each
				        if [Última Movimentação] = null then null else Duration.Days(Hoje - [Última Movimentação]), Int64.Type),
				    ComId = Table.AddColumn(ComDiasUltima, "ID Trabalho", each [Nº PROA] & " | " & [Função] & " | " & [Auditor], type text),
				    Tipos = Table.TransformColumnTypes(ComId, {
				        {"Nº PROA", type text}, {"Função", type text}, {"Auditor", type text}, {"Data Designação", type nullable date},
				        {"Status do Processo", type nullable text}, {"Fase", type text}, {"Fase Ordem", Int64.Type}, {"Etapa", type text}, {"Com Quem", type text}}),
				    Final = Table.SelectColumns(Tipos, {
				        "ID Trabalho", "Nº PROA", "Função", "Auditor", "Fase", "Fase Ordem", "Etapa", "Com Quem", "Com Quem Ordem",
				        "Status do Processo", "Data Designação", "Data RAI", "Data RAF", "Última Movimentação",
				        "Dias desde a Designação", "Dias desde a Última Movimentação"})
				in
				    Final

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

