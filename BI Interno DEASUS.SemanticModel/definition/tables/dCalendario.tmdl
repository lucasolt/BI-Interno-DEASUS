/// Calendário. Ativas: fDesignacoes[Data Final Designação] e fAuditoria[Data Designação]. Inativas: datas de entrega/relatório e limite (USERELATIONSHIP). Medidas 'Aval ...' ignoram as relações e aplicam a regra iniciou OU concluiu no período.
table dCalendario
	lineageTag: 27df70cc-7ae1-41ef-92b2-e282e18dc834
	dataCategory: Time

	column Ano
		lineageTag: 2ced46f5-cd6f-4c02-a879-29b5bbe3e835
		summarizeBy: none
		isNameInferred
		sourceColumn: [Ano]

	column 'Mês Nº'
		lineageTag: f01b3e4a-8821-40a9-b5d6-987ad9c9bb6d
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mês Nº]

	column Mês
		lineageTag: fabfbf97-0bfd-4fb7-b5d5-23dc15b5ef74
		isNameInferred
		sourceColumn: [Mês]
		sortByColumn: 'Mês Nº'

	column Mês/Ano
		lineageTag: 63432ccf-7afb-4f38-8b3f-3a9cbd9bd2db
		isNameInferred
		sourceColumn: [Mês/Ano]
		sortByColumn: AnoMês

	column AnoMês
		isHidden
		lineageTag: 4ae3499c-7d9b-48fe-ae58-7a72f9f8612d
		summarizeBy: none
		isNameInferred
		sourceColumn: [AnoMês]

	column Trimestre
		lineageTag: 8f0bcd23-cbdd-43a2-81ad-0c95fa95289f
		isNameInferred
		sourceColumn: [Trimestre]

	column Ano/Trimestre
		lineageTag: 1937e208-568d-4aef-b492-48b637efddd6
		isNameInferred
		sourceColumn: [Ano/Trimestre]
		sortByColumn: AnoTrimestre

	column AnoTrimestre
		isHidden
		lineageTag: 212bd867-d938-4e36-8361-bca52643f9ff
		summarizeBy: none
		isNameInferred
		sourceColumn: [AnoTrimestre]

	column Semestre
		lineageTag: 3baa0989-8f8f-4248-b079-88de230f6665
		isNameInferred
		sourceColumn: [Semestre]

	column Ano/Semestre
		lineageTag: a6b239e3-4329-40ea-b5da-df980eb8339c
		isNameInferred
		sourceColumn: [Ano/Semestre]
		sortByColumn: AnoSemestre

	column AnoSemestre
		isHidden
		summarizeBy: none
		lineageTag: fd5a0331-1a07-4076-aebd-80fdef983925
		isNameInferred
		sourceColumn: [AnoSemestre]

	column Quadrimestre
		lineageTag: 28c797fc-6db5-4e83-9186-aee95806ed08
		isNameInferred
		sourceColumn: [Quadrimestre]

	column Ano/Quadrimestre
		lineageTag: ae9f662a-6f30-438b-b7a5-be8df8032efd
		isNameInferred
		sourceColumn: [Ano/Quadrimestre]
		sortByColumn: AnoQuadrimestre

	column AnoQuadrimestre
		isHidden
		summarizeBy: none
		lineageTag: 66383903-ab72-4a55-b6b5-bb9c59006ab9
		isNameInferred
		sourceColumn: [AnoQuadrimestre]

	column Data
		isUnique
		isKey
		formatString: dd/mm/yyyy
		lineageTag: 0528d088-a300-46c9-a237-f468c95e0973
		isNameInferred
		sourceColumn: [Data]

	partition dCalendario = calculated
		mode: import
		source =
				VAR _Ini = MINX({MIN(fDesignacoes[Data Inicial Designação]), MIN(fDesignacoes[Data Final Designação]), MIN(fDesignacoes[Data Relatório]), MIN(fAuditoria[Data Designação]), MIN(fAuditoria[Data Entrega])}, [Value])
				VAR _Fim = MAXX({MAX(fDesignacoes[Data Limite]), MAX(fDesignacoes[Data Relatório]), MAX(fAuditoria[Data Limite]), MAX(fAuditoria[Data Entrega]), TODAY()}, [Value])
				VAR _Datas = SELECTCOLUMNS(CALENDAR(DATE(YEAR(_Ini), 1, 1), DATE(YEAR(_Fim), 12, 31)), "Data", [Date])
				RETURN
				ADDCOLUMNS(
				    _Datas,
				    "Ano", YEAR([Data]),
				    "Mês Nº", MONTH([Data]),
				    "Mês", FORMAT([Data], "mmm"),
				    "Mês/Ano", FORMAT([Data], "mmm/yy"),
				    "AnoMês", YEAR([Data]) * 100 + MONTH([Data]),
				    "Trimestre", "T" & QUARTER([Data]),
				    "Ano/Trimestre", YEAR([Data]) & "-T" & QUARTER([Data]),
				    "AnoTrimestre", YEAR([Data]) * 10 + QUARTER([Data]),
				    "Semestre", "S" & (INT((MONTH([Data]) - 1) / 6) + 1),
				    "Ano/Semestre", YEAR([Data]) & "-S" & (INT((MONTH([Data]) - 1) / 6) + 1),
				    "AnoSemestre", YEAR([Data]) * 10 + INT((MONTH([Data]) - 1) / 6) + 1,
				    "Quadrimestre", "Q" & (INT((MONTH([Data]) - 1) / 4) + 1),
				    "Ano/Quadrimestre", YEAR([Data]) & "-Q" & (INT((MONTH([Data]) - 1) / 4) + 1),
				    "AnoQuadrimestre", YEAR([Data]) * 10 + INT((MONTH([Data]) - 1) / 4) + 1
				)

