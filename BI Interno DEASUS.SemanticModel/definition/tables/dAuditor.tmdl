/// Dimensão de auditores: cadastro SERVIDORES (aba APOIO) + nomes das designações fora do cadastro (Cadastrado = Não).
table dAuditor
	lineageTag: 944426cb-b61b-409b-9e96-52f0ffb0682d

	column Auditor
		dataType: string
		isKey
		lineageTag: 40c1f14a-c7df-4bdb-a463-ba3f107ec066
		sourceColumn: Auditor

	column 'É Auditor'
		dataType: string
		lineageTag: 903d8a75-19cc-4909-8714-b09636cec043
		sourceColumn: É Auditor

	column Lotação
		dataType: string
		lineageTag: 37e00d50-7baa-4841-9df4-9a4a2f500637
		sourceColumn: Lotação

	column Ativo
		dataType: string
		lineageTag: c449652a-63e1-4ca7-922f-c6635d1452c3
		sourceColumn: Ativo

	column Cadastrado
		dataType: string
		lineageTag: b321965a-9aad-4406-9302-95461aded94e
		sourceColumn: Cadastrado

	column 'Possui Designação'
		dataType: string
		lineageTag: 670b1022-d4b6-48b1-81b6-223f705b7c41
		sourceColumn: Possui Designação

	partition dAuditor = m
		mode: import
		source =
				let
				    Cadastro = Table.AddColumn(Table.RemoveColumns(stgAuditores, {"NomeChave"}), "Cadastrado", each "Sim", type text),
				    NomesMonit = List.Distinct(fDesignacoes[Auditor]),
				    NomesAud = List.Distinct(fAuditoria[Auditor]),
				    NomesFato = List.Buffer(List.Distinct(NomesMonit & NomesAud)),
				    Faltantes = List.Difference(NomesFato, Cadastro[Auditor]),
				    TabFaltantes = Table.FromRecords(
				        List.Transform(Faltantes, each [Auditor = _, #"É Auditor" = null, Lotação = null, Ativo = null, Cadastrado = "Não"]),
				        type table [Auditor = text, #"É Auditor" = nullable text, Lotação = nullable text, Ativo = nullable text, Cadastrado = text]),
				    Unido = Table.Combine({Cadastro, TabFaltantes}),
				    ComDesignacao = Table.AddColumn(Unido, "Possui Designação", each if List.Contains(NomesFato, [Auditor]) then "Sim" else "Não", type text),
				    Tipado = Table.TransformColumnTypes(ComDesignacao, {
				        {"Auditor", type text}, {"É Auditor", type nullable text}, {"Lotação", type nullable text},
				        {"Ativo", type nullable text}, {"Cadastrado", type text}})
				in
				    Tipado

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Exception

