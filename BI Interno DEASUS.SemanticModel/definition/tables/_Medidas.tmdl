	/// Processos em aberto na fase de auditoria cuja designação mais antiga cai na faixa (dFaixaAberto). Não segue o filtro de Período.
	measure 'Aberto Aud na Faixa' =
			VAR _min = SELECTEDVALUE(dFaixaAberto[Dias Mín])
			VAR _max = SELECTEDVALUE(dFaixaAberto[Dias Máx])
			VAR _semData = SELECTEDVALUE(dFaixaAberto[Ordem]) = 6
			VAR _proc = ADDCOLUMNS(VALUES(fCarteira[Nº PROA]), "@d", CALCULATE(MAX(fCarteira[Dias desde a Designação])))
			RETURN
			    IF(HASONEVALUE(dFaixaAberto[Faixa]),
			        COUNTROWS(FILTER(_proc, IF(_semData, ISBLANK([@d]), NOT ISBLANK([@d]) && [@d] >= _min && [@d] <= _max))),
			        COUNTROWS(_proc)
			    )
		formatString: #,0
		displayFolder: 8. Carteira Atual
