	/// Processos em aberto na fase de auditoria (na linha de um auditor = os processos dele). Não segue o filtro de Período.
	measure 'Carteira Auditoria' =
			VAR _v = DISTINCTCOUNT(fCarteira[Nº PROA])
			// 0 só nos cartões/totais; em linhas por auditor ou função fica vazio (não cria linhas sem nada)
			RETURN IF(ISINSCOPE(dAuditor[Auditor]) || ISINSCOPE(dFuncao[Função]), _v, _v + 0)
		formatString: #,0
		displayFolder: 8. Carteira Atual
		lineageTag: ac245758-6ee2-4f79-aa81-a31622e9867a

	measure 'Carteira Aud Coordenador' =
			VAR _v = CALCULATE(COUNTROWS(fCarteira), KEEPFILTERS(fCarteira[Função] = "Coordenador"))
			// 0 só nos cartões/totais; em linhas por auditor ou função fica vazio (não cria linhas sem nada)
			RETURN IF(ISINSCOPE(dAuditor[Auditor]) || ISINSCOPE(dFuncao[Função]), _v, _v + 0)
		formatString: #,0
		displayFolder: 8. Carteira Atual
		lineageTag: bdcd700c-b4f9-4612-b039-8a9e82412a87

