	/// Trabalhos já designados (fTrabalhosAbertos): processos distintos por tipo, somados entre Auditoria e Monitoramento.
	measure 'Trabalhos em Aberto' =
			// botões dos cartões (pCartaoAud / pCartaoMon), modo foco: o tipo clicado é filtrado por Com Quem; o outro tipo some
			VAR _fa = ISFILTERED(pCartaoAud[Situação])
			VAR _fm = ISFILTERED(pCartaoMon[Situação])
			VAR _v = SUMX(VALUES(fTrabalhosAbertos[Tipo]),
			    SWITCH(TRUE(),
			        fTrabalhosAbertos[Tipo] = "Auditoria" && _fa,
			            CALCULATE(DISTINCTCOUNT(fTrabalhosAbertos[Nº PROA]), KEEPFILTERS(TREATAS(VALUES(pCartaoAud[Chave]), fTrabalhosAbertos[Com Quem]))),
			        fTrabalhosAbertos[Tipo] = "Monitoramento" && _fm,
			            CALCULATE(DISTINCTCOUNT(fTrabalhosAbertos[Nº PROA]), KEEPFILTERS(TREATAS(VALUES(pCartaoMon[Chave]), fTrabalhosAbertos[Com Quem]))),
			        _fa || _fm, BLANK(),
			        CALCULATE(DISTINCTCOUNT(fTrabalhosAbertos[Nº PROA]))))
			// 0 só nos cartões/totais; em linhas por auditor ou função fica vazio (não cria linhas sem nada)
			RETURN IF(ISINSCOPE(dAuditor[Auditor]) || ISINSCOPE(dFuncao[Função]), _v, _v + 0)
		formatString: #,0
		displayFolder: 8. Carteira Atual
		lineageTag: c499f1d1-0531-4bd9-a31b-ffb19e80ef65

	/// Coluna da matriz Trabalhos por Auditor: Auditoria, Aguardando designação (medida própria para permitir ordenar pela coluna).
