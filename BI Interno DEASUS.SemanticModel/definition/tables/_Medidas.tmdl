	/// Idade média dos processos em aberto (hoje − Data de Designação), por processo.
	measure 'Carteira Aud Dias Médios desde a Designação' = AVERAGEX(VALUES(fCarteira[Nº PROA]), CALCULATE(MAX(fCarteira[Dias desde a Designação])))
		formatString: #,0
