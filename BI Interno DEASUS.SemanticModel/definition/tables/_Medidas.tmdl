/// Tabela de medidas do painel de produtividade.
table _Medidas
	lineageTag: 405d4984-d72f-4a45-b69d-3197dcea8b74

	/// Total de designações (auditor x função x processo x ciclo).
	measure Designações = COUNTROWS(fDesignacoes)
		formatString: #,0
		displayFolder: 1. Produção
		lineageTag: 2a8bd501-36b4-41cf-ac10-298560661657

	measure 'Designações Coordenador' = CALCULATE([Designações], KEEPFILTERS(fDesignacoes[Função] = "Coordenador"))
		formatString: #,0
		displayFolder: 1. Produção
		lineageTag: 5d9f9638-9ba7-4c3c-9696-75480a62023d

	measure 'Designações Equipe' = CALCULATE([Designações], KEEPFILTERS(fDesignacoes[Função] = "Equipe"))
		formatString: #,0
		displayFolder: 1. Produção
		lineageTag: 9cdd0b8a-ce61-417f-a561-40d0e2811442

	/// Designações distintas (PROA x Ciclo), sem multiplicar pelos membros da equipe.
	measure 'Monitoramentos Designados' = DISTINCTCOUNT(fDesignacoes[ID Designação])
		formatString: #,0
		displayFolder: 1. Produção
		lineageTag: 66b3ccc6-1c7f-49b1-ad8f-a7ab36f0d2d7

	measure 'Relatórios Entregues' = CALCULATE([Monitoramentos Designados], KEEPFILTERS(fDesignacoes[Situação] IN {"No prazo", "Fora do prazo"}))
		formatString: #,0
		displayFolder: 1. Produção
		lineageTag: eafc6e31-dea8-46de-837e-3f5e092fcacb

	/// Relatórios distintos (PROA x Ciclo) entregues.
	measure 'Relatórios Entregues (únicos)' = CALCULATE([Monitoramentos Designados], KEEPFILTERS(fDesignacoes[Situação] IN {"No prazo", "Fora do prazo"}))
		formatString: #,0
		displayFolder: 1. Produção
		lineageTag: 81f48b07-3842-4e79-a701-a74b0b60e66c

	measure 'Entregues no Prazo' = CALCULATE([Monitoramentos Designados], KEEPFILTERS(fDesignacoes[Situação] = "No prazo"))
		formatString: #,0
		displayFolder: 1. Produção
		lineageTag: f3da6954-9511-4eb8-8d0b-847aaaf09619

	measure 'Entregues Fora do Prazo' = CALCULATE([Monitoramentos Designados], KEEPFILTERS(fDesignacoes[Situação] = "Fora do prazo"))
		formatString: #,0
		displayFolder: 1. Produção
		lineageTag: 4dc47402-4b1d-4e82-b154-f920bf4b46fc

	/// Sem data de relatório (ciclo aberto).
	measure 'Relatórios Pendentes' = CALCULATE([Monitoramentos Designados], KEEPFILTERS(fDesignacoes[Situação] = "Em andamento"))
		formatString: #,0
		displayFolder: 1. Produção
		lineageTag: 122eead8-7387-4731-a069-a281a86be5a2

	/// Sem relatório, ainda dentro do prazo.
	measure 'Em Andamento' = CALCULATE([Monitoramentos Designados], KEEPFILTERS(fDesignacoes[Situação] = "Em andamento"))
		formatString: #,0
		displayFolder: 1. Produção
		lineageTag: b40862b3-7e37-4e43-9bd3-54ae8ab92d48

	/// Designações sem Data Final de Designação (prazo não mensurável).
	measure 'Sem Prazo Definido' = CALCULATE([Monitoramentos Designados], KEEPFILTERS(fDesignacoes[Situação] = "Sem prazo definido"))
		formatString: #,0
		displayFolder: 1. Produção
		lineageTag: 2bd5553f-f988-4656-b219-8db94536bcf6

	measure 'Auditores com Designação' = CALCULATE(DISTINCTCOUNT(fDesignacoes[Auditor]), KEEPFILTERS(fDesignacoes[Auditor] <> "(Não informado)"))
		formatString: #,0
		displayFolder: 1. Produção
		lineageTag: 2bb13fc8-2d17-4e55-bed0-2bdc09d161b6

	/// Designações aplicáveis: entregues + em andamento (base da Taxa de Entrega; sem régua de prazo).
	measure 'Designações Encerradas' = [Relatórios Entregues] + [Em Andamento]
		formatString: #,0
		displayFolder: 2. Prazo
		lineageTag: 3af72986-8a19-4d44-8b02-d7b5942a035d

	/// Entregues ÷ Designações encerradas (entregues + vencidas).
	measure 'Taxa de Entrega' = DIVIDE([Relatórios Entregues], [Designações Encerradas])
		formatString: 0.00%
		displayFolder: 2. Prazo
		lineageTag: a3b54a1e-8011-41ef-972b-d4827df2727d

	/// Entregues no prazo ÷ Entregues.
	measure 'Taxa de Pontualidade' = DIVIDE([Entregues no Prazo], [Relatórios Entregues])
		formatString: 0.00%
		displayFolder: 2. Prazo
		lineageTag: 31147c08-6ead-418a-9f1d-91e828519d8a

	measure '% Entregues s/ Designações' = DIVIDE([Relatórios Entregues], [Monitoramentos Designados])
		formatString: 0.00%
		displayFolder: 2. Prazo
		lineageTag: 489d8e80-a29f-45d8-a233-0828708269a2

	measure '% No Prazo s/ Designações' = DIVIDE([Entregues no Prazo], [Monitoramentos Designados])
		formatString: 0.00%
		displayFolder: 2. Prazo
		lineageTag: 3b1e75a3-3cbb-4694-8fb8-b5b6e443a2b7

	measure '% Fora do Prazo s/ Designações' = DIVIDE([Entregues Fora do Prazo], [Monitoramentos Designados])
		formatString: 0.00%
		displayFolder: 2. Prazo
		lineageTag: 1461748b-6d75-4f6d-afc7-eb463260abea

	/// Média de (Data Relatório − Data Inicial da Designação) por relatório entregue (PROA x Ciclo, não pondera pelo tamanho da equipe). Ignora dias negativos (erro de digitação).
	measure 'Dias Médios para Entrega' =
			CALCULATE(
			    AVERAGEX(VALUES(fDesignacoes[ID Designação]), CALCULATE(MAX(fDesignacoes[Dias para Entrega]))),
			    KEEPFILTERS(fDesignacoes[Situação] IN {"No prazo", "Fora do prazo"}),
			    KEEPFILTERS(fDesignacoes[Dias para Entrega] >= 0)
			)
		formatString: #,0.0
		displayFolder: 2. Prazo
		lineageTag: c19c25b4-3bfb-4c8c-a850-ddc4ebd72218

	/// Média de (Data Relatório − Data Limite) por relatório entregue fora do prazo (PROA x Ciclo).
	measure 'Dias Médios de Atraso' =
			CALCULATE(
			    AVERAGEX(VALUES(fDesignacoes[ID Designação]), CALCULATE(MAX(fDesignacoes[Dias de Atraso]))),
			    KEEPFILTERS(fDesignacoes[Situação] = "Fora do prazo")
			)
		formatString: #,0.0
		displayFolder: 2. Prazo
		lineageTag: c349a9d5-9128-4d4b-8d98-f46e212d3ead

	/// Prazo padrão aplicado (parâmetro PrazoPadraoDias no Power Query).
	measure 'Prazo Padrão (dias)' = MAXX(ALL(fDesignacoes), DATEDIFF(fDesignacoes[Data Final Designação], fDesignacoes[Data Limite], DAY))
		formatString: #,0
		displayFolder: 2. Prazo
		lineageTag: c43444d5-6016-4cfc-9cc7-225d26156474

	/// Relatórios entregues no mês da Data do Relatório.
	measure 'Entregas (por Data Relatório)' = CALCULATE([Relatórios Entregues], USERELATIONSHIP(fDesignacoes[Data Relatório], dCalendario[Data]))
		formatString: #,0
		displayFolder: 3. Evolução Mensal
		lineageTag: bb8dd223-7bfa-4847-8c8e-f4a07384e565

	measure 'Entregas no Prazo (por Data Relatório)' = CALCULATE([Entregues no Prazo], USERELATIONSHIP(fDesignacoes[Data Relatório], dCalendario[Data]))
		formatString: #,0
		displayFolder: 3. Evolução Mensal
		lineageTag: 973087d7-8357-4e12-b839-1bac6c4f4c97

	measure 'Entregas Fora do Prazo (por Data Relatório)' = CALCULATE([Entregues Fora do Prazo], USERELATIONSHIP(fDesignacoes[Data Relatório], dCalendario[Data]))
		formatString: #,0
		displayFolder: 3. Evolução Mensal
		lineageTag: c1be8168-507b-4777-974c-6093456edd79

	/// Designações do auditor ÷ maior nº de designações entre os auditores visíveis.
	measure 'Participação Relativa' = DIVIDE([Designações], MAXX(ALLSELECTED(dAuditor[Auditor]), [Designações]))
		formatString: 0.00%
		displayFolder: 4. Índice
		lineageTag: fa7b5261-aaa8-4892-811c-6d9df87ca979

	/// 40% Taxa de Entrega + 40% Taxa de Pontualidade + 20% Participação Relativa.
	measure 'Índice de Produtividade' = IF(NOT ISBLANK([Designações]), 0.4 * [Taxa de Entrega] + 0.4 * [Taxa de Pontualidade] + 0.2 * [Participação Relativa])
		formatString: 0.00
		displayFolder: 4. Índice
		lineageTag: 30273916-61f9-4976-b77b-14c9bd91a492

	measure 'Ranking Produtividade' =
			IF(
			    HASONEVALUE(dAuditor[Auditor]) && NOT ISBLANK([Designações]),
			    RANKX(
			        FILTER(ALLSELECTED(dAuditor[Auditor]), NOT ISBLANK([Designações]) && dAuditor[Auditor] <> "(Não informado)"),
			        [Índice de Produtividade], , DESC, Dense
			    )
			)
		formatString: 0
		displayFolder: 4. Índice
		lineageTag: 12c38b42-f4f1-46b6-8c63-f48c73a1b5db

	measure 'Última Atualização' = "Última atualização: " & FORMAT(MAX(fDesignacoes[Data de Referência]), "dd/mm/yyyy")
		displayFolder: 5. Info
		lineageTag: a04b4855-d8b9-4c54-a1c4-1a39a10ed811

	measure 'Sub Designações' = FORMAT([Designações Coordenador] + 0, "#,0") & " como coordenador · " & FORMAT([Designações Equipe] + 0, "#,0") & " como equipe"
		displayFolder: 6. Rótulos
		lineageTag: 0399a53f-b3d0-4e7f-a2ad-18552530bc19

	measure 'Sub Entregues' = FORMAT([% Entregues s/ Designações] + 0, "0.0%") & " dos ciclos designados"
		displayFolder: 6. Rótulos
		lineageTag: 9291be2d-ca1c-4fcf-8c32-13a6911ce203

	measure 'Sub No Prazo' = FORMAT([% No Prazo s/ Designações] + 0, "0.0%") & " dos ciclos designados"
		displayFolder: 6. Rótulos
		lineageTag: c5f6cc1b-8a57-4a4e-817d-ef926a91b330

	measure 'Sub Fora do Prazo' = FORMAT([% Fora do Prazo s/ Designações] + 0, "0.0%") & " dos ciclos designados"
		displayFolder: 6. Rótulos
		lineageTag: 1f7634a8-f3bd-4b24-af71-f3f116a1fdf3

	measure 'Sub Prazo Médio' = "Mediana " & FORMAT([Mediana Dias para Entrega], "#,0") & " · prazo: fim da designação + " & [Prazo Padrão (dias)]
		displayFolder: 6. Rótulos
		lineageTag: 1f500fa2-8583-4706-82e4-a0527ccc44f3

	/// Designações na fase de auditoria (PROA x Função x Auditor).
	measure 'Aud Designações' = COUNTROWS(SUMMARIZE(fAuditoria, fAuditoria[Nº PROA], fAuditoria[Função], fAuditoria[Auditor]))
		formatString: #,0
		displayFolder: 7. Auditoria
		lineageTag: 0be1193b-bb71-4bf1-8133-75aab49bc113

	measure 'Aud Designações Coordenador' = CALCULATE([Aud Designações], KEEPFILTERS(fAuditoria[Função] = "Coordenador"))
		formatString: #,0
		displayFolder: 7. Auditoria
		lineageTag: 0698c096-7492-42af-a75f-60f9124c67d4

	measure 'Aud Designações Equipe' = CALCULATE([Aud Designações], KEEPFILTERS(fAuditoria[Função] = "Equipe"))
		formatString: #,0
		displayFolder: 7. Auditoria
		lineageTag: b51e7d5f-88ef-43ba-aad7-648d99620495

	measure 'Aud Processos Designados' = DISTINCTCOUNT(fAuditoria[Nº PROA])
		formatString: #,0
		displayFolder: 7. Auditoria
		lineageTag: b952b5d5-d613-4bd0-96ff-6863bc34ae28

	/// Registros de relatório (RAI + RAF) x auditor, todas as situações.
	measure 'Aud Relatórios' = DISTINCTCOUNT(fAuditoria[ID Relatório])
		formatString: #,0
		displayFolder: 7. Auditoria
		lineageTag: 8b0535a1-8e4a-4b4b-8de5-9ff290e48d4c

	/// Relatórios esperados (exclui 'Não se aplica').
	measure 'Aud Relatórios Aplicáveis' = CALCULATE(DISTINCTCOUNT(fAuditoria[ID Relatório]), KEEPFILTERS(fAuditoria[Situação] <> "Não se aplica"))
		formatString: #,0
		displayFolder: 7. Auditoria
		lineageTag: cda06467-56c3-4388-9b52-5dec4f8f4c23

	measure 'Aud Entregues' = CALCULATE(DISTINCTCOUNT(fAuditoria[ID Relatório]), KEEPFILTERS(fAuditoria[Situação] IN {"No prazo", "Fora do prazo"}))
		formatString: #,0
		displayFolder: 7. Auditoria
		lineageTag: 0431d583-8f10-4104-9663-787b262604fd

	measure 'Aud No Prazo' = CALCULATE(DISTINCTCOUNT(fAuditoria[ID Relatório]), KEEPFILTERS(fAuditoria[Situação] = "No prazo"))
		formatString: #,0
		displayFolder: 7. Auditoria
		lineageTag: c401c1a8-6223-4fce-9d40-abc19a6351d2

	measure 'Aud Fora do Prazo' = CALCULATE(DISTINCTCOUNT(fAuditoria[ID Relatório]), KEEPFILTERS(fAuditoria[Situação] = "Fora do prazo"))
		formatString: #,0
		displayFolder: 7. Auditoria
		lineageTag: 5b5a623f-f1d7-45f6-8775-ebd94f0e748f

	measure 'Aud Em Andamento' = CALCULATE(DISTINCTCOUNT(fAuditoria[ID Relatório]), KEEPFILTERS(fAuditoria[Situação] = "Em andamento"))
		formatString: #,0
		displayFolder: 7. Auditoria
		lineageTag: e65534a0-f458-447a-8f66-d9cba20344c3

	/// Sem data de entrega em processo arquivado/fase finalizada.
	measure 'Aud Não se Aplica' = CALCULATE(DISTINCTCOUNT(fAuditoria[ID Relatório]), KEEPFILTERS(fAuditoria[Situação] = "Não se aplica"))
		formatString: #,0
		displayFolder: 7. Auditoria
		lineageTag: ed3ae117-311a-445c-b98e-2418c9e29b24

	/// Entregues ÷ (Entregues + Em andamento).
	measure 'Aud Taxa de Entrega' = DIVIDE([Aud Entregues], [Aud Entregues] + [Aud Em Andamento])
		formatString: 0.00%
		displayFolder: 7. Auditoria
		lineageTag: f1124f1f-8bee-4c01-9005-4eaac2090927

	/// No prazo ÷ Entregues.
	measure 'Aud Taxa de Pontualidade' = DIVIDE([Aud No Prazo], [Aud Entregues])
		formatString: 0.00%
		displayFolder: 7. Auditoria
		lineageTag: 1612363a-1413-4a3e-ae29-f98bc7935b98

	/// Média de (Data Entrega − Data Designação) por relatório entregue (PROA x RAI/RAF, não pondera pelo tamanho da equipe). Ignora dias negativos (erro de digitação).
	measure 'Aud Dias Médios para Entrega' =
			CALCULATE(
			    AVERAGEX(VALUES(fAuditoria[ID Relatório]), CALCULATE(MAX(fAuditoria[Dias para Entrega]))),
			    KEEPFILTERS(fAuditoria[Situação] IN {"No prazo", "Fora do prazo"}),
			    KEEPFILTERS(fAuditoria[Dias para Entrega] >= 0)
			)
		formatString: #,0.0
		displayFolder: 7. Auditoria
		lineageTag: f6a48e90-b923-482c-9537-9c64e966a6c5

	/// Média de (Data Entrega − Data Limite) por relatório entregue fora do prazo (PROA x RAI/RAF).
	measure 'Aud Dias Médios de Atraso' =
			CALCULATE(
			    AVERAGEX(VALUES(fAuditoria[ID Relatório]), CALCULATE(MAX(fAuditoria[Dias de Atraso]))),
			    KEEPFILTERS(fAuditoria[Situação] = "Fora do prazo")
			)
		formatString: #,0.0
		displayFolder: 7. Auditoria
		lineageTag: 67923f3d-5838-4106-8eb2-bc3bc0fbf9c1

	/// Total de matrizes de qualidade (cada relatório contado uma vez).
	measure 'Aud Matrizes de Qualidade' = SUMX(VALUES(fAuditoria[ID Relatório]), CALCULATE(MAX(fAuditoria[Matrizes de Qualidade])))
		formatString: #,0
		displayFolder: 7. Auditoria
		lineageTag: 7e62d1a3-876b-4ae1-96eb-510a18592cce

	measure 'Aud Relatórios com Matriz' = CALCULATE(DISTINCTCOUNT(fAuditoria[ID Relatório]), KEEPFILTERS(NOT ISBLANK(fAuditoria[Matrizes de Qualidade])))
		formatString: #,0
		displayFolder: 7. Auditoria
		lineageTag: 720a73d5-fdb7-4975-aec9-0cc951ff21b4

	/// Matrizes ÷ relatórios avaliados (indicador de retrabalho).
	measure 'Aud Média de Matrizes por Relatório' = DIVIDE([Aud Matrizes de Qualidade], [Aud Relatórios com Matriz])
		formatString: #,0.00
		displayFolder: 7. Auditoria
		lineageTag: 2b7bb605-ad85-4c55-9d7b-6643f842c403

	measure 'Aud Entregas (por Data Entrega)' = CALCULATE([Aud Entregues], USERELATIONSHIP(fAuditoria[Data Entrega], dCalendario[Data]))
		formatString: #,0
		displayFolder: 7. Auditoria
		lineageTag: 7a3a1f52-5a9b-4cff-865c-e1a76b55f861

	measure 'Aud No Prazo (por Data Entrega)' = CALCULATE([Aud No Prazo], USERELATIONSHIP(fAuditoria[Data Entrega], dCalendario[Data]))
		formatString: #,0
		displayFolder: 7. Auditoria
		lineageTag: 2406e49c-830e-4ab8-aae9-ff5d91abe604

	measure 'Aud Fora do Prazo (por Data Entrega)' = CALCULATE([Aud Fora do Prazo], USERELATIONSHIP(fAuditoria[Data Entrega], dCalendario[Data]))
		formatString: #,0
		displayFolder: 7. Auditoria
		lineageTag: 47c65919-c881-4ad4-a26c-52b97fccf603

	measure 'RAI Entregues' = CALCULATE([Aud Entregues], KEEPFILTERS(fAuditoria[Relatório] = "RAI"))
		formatString: #,0
		displayFolder: 7. Auditoria\RAI
		lineageTag: 44296aa8-ab21-4f0a-95fc-fe6694eb081e

	measure 'RAI No Prazo' = CALCULATE([Aud No Prazo], KEEPFILTERS(fAuditoria[Relatório] = "RAI"))
		formatString: #,0
		displayFolder: 7. Auditoria\RAI
		lineageTag: 41aac5c2-5374-4736-b975-3df925d76b5b

	measure 'RAI Fora do Prazo' = CALCULATE([Aud Fora do Prazo], KEEPFILTERS(fAuditoria[Relatório] = "RAI"))
		formatString: #,0
		displayFolder: 7. Auditoria\RAI
		lineageTag: 95f60155-2441-4d0f-803b-80899e831d62

	measure 'RAI Taxa de Entrega' = CALCULATE([Aud Taxa de Entrega], KEEPFILTERS(fAuditoria[Relatório] = "RAI"))
		formatString: 0.00%
		displayFolder: 7. Auditoria\RAI
		lineageTag: 69996917-36d3-4693-b5b8-d32646f5767c

	measure 'RAI Taxa de Pontualidade' = CALCULATE([Aud Taxa de Pontualidade], KEEPFILTERS(fAuditoria[Relatório] = "RAI"))
		formatString: 0.00%
		displayFolder: 7. Auditoria\RAI
		lineageTag: f561be7c-f404-483d-b89d-4be8e3353970

	measure 'RAI Dias Médios para Entrega' = CALCULATE([Aud Dias Médios para Entrega], KEEPFILTERS(fAuditoria[Relatório] = "RAI"))
		formatString: #,0.0
		displayFolder: 7. Auditoria\RAI
		lineageTag: ea9f06d1-2000-4cd9-b5d7-544d369f4d55

	measure 'RAI Dias Médios de Atraso' = CALCULATE([Aud Dias Médios de Atraso], KEEPFILTERS(fAuditoria[Relatório] = "RAI"))
		formatString: #,0.0
		displayFolder: 7. Auditoria\RAI
		lineageTag: 5dd2b7e2-dfce-4356-9bc1-88b904b9e72b

	measure 'RAI Média de Matrizes' = CALCULATE([Aud Média de Matrizes por Relatório], KEEPFILTERS(fAuditoria[Relatório] = "RAI"))
		formatString: #,0.00
		displayFolder: 7. Auditoria\RAI
		lineageTag: 115dbb39-b11a-49b2-b59e-a4a5a0756fb7

	measure 'RAF Entregues' = CALCULATE([Aud Entregues], KEEPFILTERS(fAuditoria[Relatório] = "RAF"))
		formatString: #,0
		displayFolder: 7. Auditoria\RAF
		lineageTag: 5d0e86dc-ac9a-4987-97e2-bab598dd8c76

	measure 'RAF No Prazo' = CALCULATE([Aud No Prazo], KEEPFILTERS(fAuditoria[Relatório] = "RAF"))
		formatString: #,0
		displayFolder: 7. Auditoria\RAF
		lineageTag: 2203d0d5-16c6-4c1b-87c5-a1084fd218e7

	measure 'RAF Fora do Prazo' = CALCULATE([Aud Fora do Prazo], KEEPFILTERS(fAuditoria[Relatório] = "RAF"))
		formatString: #,0
		displayFolder: 7. Auditoria\RAF
		lineageTag: d51f6f9b-c8f5-4336-83b6-9def1befe3cf

	measure 'RAF Taxa de Entrega' = CALCULATE([Aud Taxa de Entrega], KEEPFILTERS(fAuditoria[Relatório] = "RAF"))
		formatString: 0.00%
		displayFolder: 7. Auditoria\RAF
		lineageTag: 06f1cb5b-404b-4572-b8ba-f91461f6fdd4

	measure 'RAF Taxa de Pontualidade' = CALCULATE([Aud Taxa de Pontualidade], KEEPFILTERS(fAuditoria[Relatório] = "RAF"))
		formatString: 0.00%
		displayFolder: 7. Auditoria\RAF
		lineageTag: 544b0931-83c5-484e-a63b-cc68c2b99359

	measure 'RAF Dias Médios para Entrega' = CALCULATE([Aud Dias Médios para Entrega], KEEPFILTERS(fAuditoria[Relatório] = "RAF"))
		formatString: #,0.0
		displayFolder: 7. Auditoria\RAF
		lineageTag: e63693d6-6d94-4ec4-8cf9-228a6e56f9fd

	measure 'RAF Dias Médios de Atraso' = CALCULATE([Aud Dias Médios de Atraso], KEEPFILTERS(fAuditoria[Relatório] = "RAF"))
		formatString: #,0.0
		displayFolder: 7. Auditoria\RAF
		lineageTag: cf480132-1b8a-49f3-9e47-3a91a4d04498

	measure 'RAF Média de Matrizes' = CALCULATE([Aud Média de Matrizes por Relatório], KEEPFILTERS(fAuditoria[Relatório] = "RAF"))
