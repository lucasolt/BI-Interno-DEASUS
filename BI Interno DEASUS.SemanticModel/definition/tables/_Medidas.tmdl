			VAR _minA = MINX(_aud, CALCULATE([Trab Mon · Aguardando auditado], ALLSELECTED(dFuncao[Função])))
			VAR _maxA = MAXX(_aud, CALCULATE([Trab Mon · Aguardando auditado], ALLSELECTED(dFuncao[Função])))
			VAR _minF = MINX(_audFun, [Trab Mon · Aguardando auditado])
			VAR _maxF = MAXX(_audFun, [Trab Mon · Aguardando auditado])
			VAR _min = MIN(_minA, _minF)
			VAR _max = MAX(_maxA, _maxF)
			VAR _nivel = IF(_max = _min, 0, MIN(9, INT(DIVIDE(_v - _min, _max - _min) * 10)))
			RETURN IF(ISINSCOPE(dAuditor[Auditor]) && NOT ISBLANK(_v),
			    LOOKUPVALUE(dPaleta[Cor], dPaleta[Paleta], "Heat volume", dPaleta[Nível], _nivel))
		displayFolder: 6. Rótulos\Heat map
		lineageTag: 6427a5dc-706d-4ea9-98fd-2b9e6cbedc23

	/// 1 = linha da tabela de auditoria aparece com os botões clicados (filtro de visual = 1).
	measure 'Filtro Cartão Aud' =
			// modo foco: botão só de Monitoramento esconde a auditoria; botão de Auditoria filtra por Com Quem
			VAR _fa = ISFILTERED(pCartaoAud[Situação])
			VAR _fm = ISFILTERED(pCartaoMon[Situação])
			VAR _n = CALCULATE(COUNTROWS(fCarteira), KEEPFILTERS(TREATAS(VALUES(pCartaoAud[Chave]), fCarteira[Com Quem])))
			RETURN IF(_fa, IF(_n > 0, 1, 0), IF(_fm, 0, 1))
		formatString: 0
		displayFolder: 8. Carteira Atual
		lineageTag: af16368c-f4bf-4599-a2a2-2bac6cf6c511

	/// 1 = linha da tabela de monitoramento passa nos botões clicados (filtro de visual = 1).
	measure 'Filtro Cartão Mon' =
			// modo foco: botão só de Auditoria esconde o monitoramento; botão de Monitoramento filtra por Com Quem
			VAR _fa = ISFILTERED(pCartaoAud[Situação])
			VAR _fm = ISFILTERED(pCartaoMon[Situação])
			VAR _n = CALCULATE(COUNTROWS(fMonitAberto), KEEPFILTERS(TREATAS(VALUES(pCartaoMon[Chave]), fMonitAberto[Com Quem])))
			RETURN IF(_fm, IF(_n > 0, 1, 0), IF(_fa, 0, 1))
		formatString: 0
		displayFolder: 8. Carteira Atual
		lineageTag: 27b510ae-2976-4019-b08d-9819e5b59aab

	/// Número exibido em cada botão de pCartaoAud.
