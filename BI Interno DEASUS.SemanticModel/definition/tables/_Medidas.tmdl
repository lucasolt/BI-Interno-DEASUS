	measure 'Cor Heat · Trab Aud · Aguardando designação' =
			VAR _v = [Trab Aud · Aguardando designação]
			// mesma régua da coluna: linhas de auditor e de auditor × função no mesmo mínimo/máximo
			VAR _aud = ALLSELECTED(dAuditor[Auditor])
			VAR _audFun = CROSSJOIN(ALLSELECTED(dAuditor[Auditor]), ALLSELECTED(dFuncao[Função]))
			VAR _minA = MINX(_aud, CALCULATE([Trab Aud · Aguardando designação], ALLSELECTED(dFuncao[Função])))
			VAR _maxA = MAXX(_aud, CALCULATE([Trab Aud · Aguardando designação], ALLSELECTED(dFuncao[Função])))
			VAR _minF = MINX(_audFun, [Trab Aud · Aguardando designação])
			VAR _maxF = MAXX(_audFun, [Trab Aud · Aguardando designação])
			VAR _min = MIN(_minA, _minF)
			VAR _max = MAX(_maxA, _maxF)
			VAR _nivel = IF(_max = _min, 0, MIN(9, INT(DIVIDE(_v - _min, _max - _min) * 10)))
			RETURN IF(ISINSCOPE(dAuditor[Auditor]) && NOT ISBLANK(_v),
			    LOOKUPVALUE(dPaleta[Cor], dPaleta[Paleta], "Heat volume", dPaleta[Nível], _nivel))
		displayFolder: 6. Rótulos\Heat map
		lineageTag: 74c05321-f027-408d-809a-a00bc5129867

