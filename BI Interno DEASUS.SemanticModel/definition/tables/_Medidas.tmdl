			SWITCH(SELECTEDVALUE(pCartaoAud[Chave]),
			    "Aguardando designação", [Carteira Aud Sem Designação],
			    "Com a equipe", [Carteira Aud Com a Equipe],
			    "Com a chefia", [Carteira Aud Com a Chefia],
