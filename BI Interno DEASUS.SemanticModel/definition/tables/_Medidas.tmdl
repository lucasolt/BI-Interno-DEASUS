	/// Entradas conforme o seletor pAreaGrafico (padrão: auditoria + monitoramento).
	measure 'Gráfico Fluxo Entradas' =
			VAR _a = SELECTEDVALUE(pAreaGrafico[Área], "Auditoria e Monitoramento")
			RETURN
			    SWITCH(_a,
			        "Auditoria", [Fluxo Aud Entradas],
			        "Monitoramento", [Fluxo Mon Entradas],
			        [Fluxo Aud Entradas] + [Fluxo Mon Entradas]
			    )
