	/// Mediana de (Data Relatório − Data Inicial da Designação) por relatório entregue. Menos sensível a casos extremos que a média.
	measure 'Mediana Dias para Entrega' =
			CALCULATE(
			    MEDIANX(VALUES(fDesignacoes[ID Designação]), CALCULATE(MAX(fDesignacoes[Dias para Entrega]))),
			    KEEPFILTERS(fDesignacoes[Situação] IN {"No prazo", "Fora do prazo"}),
			    KEEPFILTERS(fDesignacoes[Dias para Entrega] >= 0)
			)
		formatString: #,0.0
		displayFolder: 2. Prazo
		lineageTag: 78317c80-5771-4897-b67a-9eb17c273099

	/// Mediana de (Data Entrega − Data Designação) por relatório entregue.
	measure 'Aud Mediana Dias para Entrega' =
			CALCULATE(
			    MEDIANX(VALUES(fAuditoria[ID Relatório]), CALCULATE(MAX(fAuditoria[Dias para Entrega]))),
			    KEEPFILTERS(fAuditoria[Situação] IN {"No prazo", "Fora do prazo"}),
			    KEEPFILTERS(fAuditoria[Dias para Entrega] >= 0)
			)
		formatString: #,0.0
		displayFolder: 7. Auditoria
		lineageTag: 96a61a0c-c915-4812-970f-19ab3c67a60f

	/// Idade média (hoje − Data Designação) dos relatórios ainda não entregues.
