	/// Processos com monitoramento em aberto cujo ciclo atual foi designado há um tempo dentro da faixa (sem designação → "Sem data de designação").
	measure 'Aberto Mon na Faixa' =
			VAR _min = SELECTEDVALUE(dFaixaAberto[Dias Mín])
			VAR _max = SELECTEDVALUE(dFaixaAberto[Dias Máx])
			VAR _semData = SELECTEDVALUE(dFaixaAberto[Ordem]) = 6
			VAR _proc = ADDCOLUMNS(VALUES(fMonitAberto[Nº PROA]), "@d", CALCULATE(MAX(fMonitAberto[Dias desde a Designação])))
			RETURN
			    IF(HASONEVALUE(dFaixaAberto[Faixa]),
			        COUNTROWS(FILTER(_proc, IF(_semData, ISBLANK([@d]), NOT ISBLANK([@d]) && [@d] >= _min && [@d] <= _max))),
			        COUNTROWS(_proc)
			    )
		formatString: #,0
		displayFolder: 8. Carteira Atual
		lineageTag: 7a403e75-b4e0-4118-a32a-3eea1ad48c08

	/// Processos em auditoria já designados (do "Aguarda criação de RAI" ao "Aguarda envio do RAF ao auditado").
	measure 'Carteira Aud Designados' =
			VAR _v = CALCULATE(DISTINCTCOUNT(fCarteira[Nº PROA]), KEEPFILTERS(fCarteira[Etapa] <> "Pré-designação"))
			// 0 só nos cartões/totais; em linhas por auditor ou função fica vazio (não cria linhas sem nada)
			RETURN IF(ISINSCOPE(dAuditor[Auditor]) || ISINSCOPE(dFuncao[Função]), _v, _v + 0)
		formatString: #,0
		displayFolder: 8. Carteira Atual
		lineageTag: 680a9050-41f5-4430-9d6b-0ef57684b8b4

	/// Processos com status "Não distribuído" (fila da chefia).
	measure 'Carteira Aud Sem Designação' =
