	column _FlagRelatorioMonitoramento
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 5a5fb2a9-59b7-44da-a546-b6cc32a91969
		summarizeBy: none
		sourceColumn: _FlagRelatorioMonitoramento

		annotation SummarizationSetBy = Automatic

	partition DadosDep_legacy = m
		mode: import
		queryGroup: cfg_dicts
		source = ```
				let
				    Fonte = Excel.Workbook(Web.Contents("https://rsgovbr.sharepoint.com/sites/SES-qualidadedeasus/Shared%20Documents/DEASUS/30%20-%20INSTRUMENTOS%20DE%20GEST%C3%83O/05%20-%20RELAT%C3%93RIO%20DETALHADO%20DO%20QUADRIMESTRE%20ANTERIOR%20(RDQA)/2023/ESTUDO%20DOS%20PROCESSOS%20PARA%20AN%C3%81LISE%20DO%20RDQA%20-%20Copiar.xlsx"), null, true),
				    PROCESSOS_Sheet = Fonte{[Item="PROCESSOS",Kind="Sheet"]}[Data],
				    #"Linhas Superiores Removidas" = Table.Skip(PROCESSOS_Sheet,2),
				    #"Cabeçalhos Promovidos" = Table.PromoteHeaders(#"Linhas Superiores Removidas", [PromoteAllScalars=true]),
				
				
				
				    #"ColSelecionadas" = fxSelecionarCols(#"Cabeçalhos Promovidos", dictDadosDep),
				
				    #"ColRenomeadas"   = fxRenameCols(#"ColSelecionadas", dictDadosDep),
				    #"ColTipadas"      = fxTyparCols(#"ColRenomeadas", dictDadosDep),
				
				    #"RetirarLinhasVazias" =
				        let
				            Fonte   = #"ColTipadas",
				            ColPROA = List.First(
				                List.Select(
				                    Table.ColumnNames(Fonte),
				                    (c) => Text.StartsWith(c, "012")
				                )
				            )
				        in
				            Table.SelectRows(
				                Fonte,
				                each not List.Contains(
				                    {null, "", "-"},
				                    try Text.Trim(Text.From(Record.Field(_, ColPROA))) otherwise null
				                )
				            ),
				
				    #"AddMonitoravel" = Table.AddColumn(#"RetirarLinhasVazias", "Monitorável?", each 
				    if [#"1C - Data Reclassificação (não monitorável)"] <> null
				       and [#"1C - Data Reclassificação (não monitorável)"] <> ""
				       and [#"1C - Data Reclassificação (não monitorável)"] > #date(1900, 1, 1)
				        then "Não"
				    else if [#"1C - Data Recebimento E-mail Ofício de Abertura"] <> null
				       and [#"1C - Data Recebimento E-mail Ofício de Abertura"] <> ""
				       and [#"1C - Data Recebimento E-mail Ofício de Abertura"] > #date(1900, 1, 1)
				        then "Sim"
				        else "Não"),
				        
				    #"AddCicloMonitoramento_tratado" = Table.AddColumn(
				        #"AddMonitoravel",
				        "Ciclo do monitoramento",
				        each
				            let
				                _bruto = Text.Trim( Text.From( [#"M - Ciclo Atual"] ) )
				            in
				                if [#"Monitorável?"] <> "Sim" then null
				                else if _bruto = null or _bruto = "" then null
				                else if List.Contains( {"1º Ciclo", "2º Ciclo", "3º Ciclo"}, _bruto ) then _bruto
				                else "⚠ Ciclo não previsto: " & _bruto,
				        type text
				    ),
				
				    #"AddResumoStatus" = Table.AddColumn(#"AddCicloMonitoramento_tratado", "Status do processo", 
				    each 
				        if [#"042 - STATUS"] = null then
				                    null
				        else if Text.Upper(Text.Trim([#"042 - STATUS"])) = "ARQUIVADO" then 
				        "Arquivado" 
				        else 
				        "Em andamento", 
				    type text),
				
				    //#"AddRotuloAuditadoPadronizadoCNES" = Table.AddColumn(
				    //    #"AddResumoStatus",
				    //    "_RotuloAuditadoPadronizadoCNES",
				    //    each try dwd_cnes_rs{[CD_CNES = [#"005 - CNES"]]}[DS_CNES] otherwise null,
				    //    type text
				    //),
				    //#"AddRotuloAuditadoPadronizadoConcatenadoCNES" = Table.AddColumn(
				    //    #"AddRotuloAuditadoPadronizadoCNES",
				    //    "_RotuloAuditadoPadronizadoConcatenadoCNES",
				    //each [_RotuloAuditadoPadronizadoCNES] & " (CNES " & Number.ToText(Int64.From([#"005 - CNES"])) & ")",
				    //type text
				    //),
				
				    #"FiltrarAnoCorte" = Table.SelectRows(
				    #"AddResumoStatus",
				    each
				        let
				            DataConvertida = try Date.From([#"013 - DATA DE ABERTURA"], "pt-BR") otherwise null
				        in
				            DataConvertida <> null
				            and Date.Year(DataConvertida) >= AnoDeCorte
				    ),
				
				    #"AplicarSigilo" = fxProcessarSigiloso(#"FiltrarAnoCorte", dictDadosDep,
				{"003 - TIPO DE AUDITORIA",
				"004 - EIXO",
				"005 - CNES",
				"006 - AUDITADO",
				"007 - TIPO DE ESTABELECIMENTO",
				"008 - MUNICÍPIO",
				
				//"013 - DATA DE ABERTURA",
				//"017 - DATA DE DESIGNAÇÃO",
				//"019 - DATA ENTREGA RELATÓRIO INICIAL EQUIPE => CHEFIA",
				//"021 - DATA ENTREGA RELATÓRIO FINAL EQUIPE => CHEFIA",
				//"022 - PRAZO ENTREGA RELATÓRIO FINAL",
				//"023 - DATA ENVIO RELATORIO INICIAL AO AUDITADO",
				//"024 - DATA RECEBIMENTO RELATORIO INICIAL",
				//"025 - DATA RECEBIMENTO DEFESA / CERTIDÃO",
				//"026 - DATA ENVIO RELATÓRIO FINAL AO AUDITADO",
				//"027 - DATA RECEBIMENTO RELATÓRIO FINAL",
				//"028 - DATA RECEBIMENTO RECURSO",
				//"029 - PRAZO FINAL",
				//"030 - DATA ENVIO DECISÃO AO AUDITADO",
				//"031 - DATA CIÊNCIA DO AUDITADO",
				"032 - PENALIDADE ADMINISTRATIVA",
				"033 - VALOR RESSARCIMENTO",
				"034 - VALOR MULTA",
				"035 - VALOR TOTAL",
				"036 - TIPO PAGAMENTO",
				//"037 - DATA PAGAMENTO",
				"042 - STATUS",
				//"1C - Data Inicial Designação",
				//"1C - Data Recebimento E-mail Ofício de Abertura",
				//"1C - Data Reclassificação (não monitorável)",
				//"1C - Data Relatório",
				"1C - Status Atual",
				//"2C - Data Inicial Designação",
				//"2C - Data Relatório",
				"2C - Status Atual",
				//"3C - Data Inicial Designação",
				//"3C - Data Relatório",
				"3C - Status Atual",
				"Ciclo do monitoramento",
				"M - Ciclo Atual",
				//"M - Data do Status Atual Geral",
				"M - Status Atual Geral do Monitoramento",
				"Status do monitoramento",
				"Status do processo"}
				    ),
				
				    #"Add_FlagRelatorioMonitoramento" = Table.AddColumn( AplicarSigilo, "_FlagRelatorioMonitoramento", each [#"1C - Data Relatório"] <> null or [#"2C - Data Relatório"] <> null or [#"3C - Data Relatório"] <> null, type logical ),
				
				    #"AplicarCasing" = fxAplicarCasing(#"Add_FlagRelatorioMonitoramento", dictDadosDep)
				in
				    AplicarCasing
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

