model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

annotation PBI_QueryOrder = ["fDesignacoes","dAuditor","dProcesso","CaminhoPlanilha","PrazoPadraoDias","fxNormalizaNome","stgProcessos","stgAuditores","AliasesAuditores"]

ref table fDesignacoes
ref table dAuditor
ref table dProcesso
ref table dCalendario
ref table _Medidas

ref cultureInfo pt-BR

